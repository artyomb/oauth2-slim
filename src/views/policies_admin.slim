.policy-page.admin-page#policy-app data-api="#{policy_path}/data" data-users-api="#{policy_path}/users" data-csrf=policy_csrf_token
  == slim :admin_navigation, layout: false
  main.admin-content
    header.admin-heading#policy-list-heading
      div
        .admin-title
          h1 = t('policy_admin.title')
          span.admin-count#policy-total
        p.admin-subtitle = t('policy_admin.subtitle')
      button.btn.btn-primary#policy-new type="button"
        svg.admin-icon aria-hidden="true"
          use href="#admin-plus"
        = t('policy_admin.new')
    #policy-message role="status" aria-live="polite"

    section.admin-surface.admin-resource#policy-list aria-label=t('policy_admin.title')
      form.admin-filters#policy-filters
        label.admin-search
          span = t('policy_admin.search')
          input type="search" name="search" maxlength="200" placeholder=t('admin_ui.search_policies')
        .admin-filter-fields#admin-filter-fields
          label
            span = t('policy_admin.resource_type')
            input name="resource_type" maxlength="200" placeholder=t('policy_admin.all')
          label
            span = t('policy_admin.action')
            input name="action" maxlength="200" placeholder=t('policy_admin.all')
          label
            span = t('policy_admin.state')
            select name="active"
              option value="" = t('policy_admin.all')
              option value="true" = t('policy_admin.enabled')
              option value="false" = t('policy_admin.disabled')
        .admin-filter-actions
          button.btn.btn-secondary.admin-filter-toggle#admin-filter-toggle type="button" aria-expanded="false" aria-controls="admin-filter-fields" = t('admin_ui.filters')
          button.btn.btn-secondary type="submit" = t('policy_admin.filter')
      .admin-results
        span.admin-result-count#policy-list-state role="status"
        .admin-filter-chips#admin-active-filters
        span#admin-filter-pending hidden=true = t('admin_ui.pending')
        button.btn.btn-quiet.admin-reset#admin-filter-reset type="button" hidden=true = t('admin_ui.reset')
      .policy-table-wrap#policy-table-wrap
        table.policy-table.admin-table
          colgroup
            - [28, 18, 13, 14, 12, 15].each do |width|
              col style="width:#{width}%"
          thead
            tr
              - %w[name resource_type effect state assignments operations].each do |field|
                th scope="col" class=(field == 'operations' ? 'admin-actions' : field == 'assignments' ? 'admin-number' : nil) = t("policy_admin.#{field}")
          tbody#policy-rows
      .admin-empty#policy-empty hidden=true
        h2#policy-empty-title = t('admin_ui.empty_policies')
        p#policy-empty-copy = t('admin_ui.empty_policies_hint')
      .policy-pagination#policy-pagination
        button.btn.btn-secondary#policy-prev type="button" = t('policy_admin.previous')
        span#policy-page-info
        button.btn.btn-secondary#policy-next type="button" = t('policy_admin.next')

    section#policy-editor hidden=true aria-labelledby="policy-editor-title"
      button.btn.btn-quiet#policy-back type="button" = t('policy_admin.back')
      .admin-heading
        div
          .admin-title
            h1#policy-editor-title
            span.policy-state#policy-editor-state
          p.policy-muted#policy-revision
      #policy-conflict hidden=true role="alert"
        p = t('policy_admin.conflict')
        button.btn.btn-secondary#policy-reload type="button" = t('policy_admin.reload')
      .policy-editor-layout
        form.admin-surface#policy-form
          .policy-form-section.policy-form-grid
            label
              span = t('policy_admin.name') + ' *'
              input name="name" id="policy-name" required=true maxlength="200" aria-describedby="error-name"
              small.policy-error#error-name
            label
              span = t('policy_admin.description')
              textarea name="description" rows="1" maxlength="4000" aria-describedby="error-description"
              small.policy-error#error-description
          .policy-form-section
            h3 = t('admin_ui.scope')
            .policy-form-grid.policy-scope-grid
              label
                span = t('policy_admin.resource_type') + ' *'
                input name="resource_type" id="policy-resource_type" required=true maxlength="200" aria-describedby="error-resource_type"
                small.policy-error#error-resource_type
              label
                span = t('policy_admin.actions') + ' *'
                input name="actions" required=true placeholder="read" aria-describedby="actions-hint error-actions"
                small.policy-error#error-actions
              label
                span = t('policy_admin.effect')
                select name="effect" aria-describedby="error-effect"
                  option value="allow" = t('policy_admin.allow')
                  option value="deny" = t('policy_admin.deny')
                small.policy-error#error-effect
            p.policy-muted#actions-hint = t('policy_admin.actions_hint')
          .policy-form-section
            .policy-heading
              label for="policy-definition" = t('policy_admin.definition')
              .policy-buttons
                button.btn.btn-quiet#policy-format type="button" = t('policy_admin.format')
                button.btn.btn-quiet#policy-example type="button" = t('policy_admin.example')
            textarea#policy-definition name="definition" rows="8" required=true spellcheck="false" aria-describedby="definition-hint error-definition"
            small.policy-error#error-definition role="alert"
            p.policy-muted#definition-hint = t('policy_admin.definition_hint')
          details.policy-form-section.policy-advanced
            summary = t('admin_ui.advanced')
            .policy-form-grid
              label
                span = t('policy_admin.priority')
                input name="priority" type="number" step="any" required=true aria-describedby="priority-hint error-priority"
                small.policy-muted#priority-hint = t('policy_admin.priority_hint')
                small.policy-error#error-priority
              label.policy-checkbox
                input name="active" type="checkbox" aria-describedby="error-active"
                span = t('policy_admin.enabled')
                small.policy-error#error-active
          .policy-save-bar
            span#policy-save-state role="status" aria-live="polite"
            .policy-buttons
              button.btn.btn-secondary#policy-cancel type="button" = t('policy_admin.cancel')
              button.btn.btn-primary#policy-save type="submit" = t('policy_admin.save')
        section.policy-assignment-section.admin-surface#policy-assignments hidden=true aria-labelledby="policy-assignments-title"
          h2#policy-assignments-title = t('policy_admin.direct_assignments')
          p.policy-muted = t('policy_admin.assignments_hint')
          p#policy-assignment-state role="status"
          ul.policy-binding-list#policy-bindings
          .policy-pagination
            button.btn.btn-secondary#binding-prev type="button" = t('policy_admin.previous')
            span#binding-page-info
            button.btn.btn-secondary#binding-next type="button" = t('policy_admin.next')
          form.policy-filters#policy-user-search
            label
              span = t('policy_admin.search_users')
              input name="search" type="search" maxlength="200"
            button.btn.btn-secondary type="submit" = t('policy_admin.search')
          p#policy-user-state role="status"
          ul.policy-binding-list#policy-user-results
          .policy-pagination
            button.btn.btn-secondary#user-prev type="button" = t('policy_admin.previous')
            span#user-page-info
            button.btn.btn-secondary#user-next type="button" = t('policy_admin.next')

    footer.admin-footer
      span Auth Slim
      span = t('policy_admin.navigation')

  dialog#policy-confirm aria-labelledby="policy-confirm-title"
    h2#policy-confirm-title = t('policy_admin.confirm')
    p#policy-confirm-text
    .policy-buttons
      button.btn.btn-primary#policy-confirm-yes type="button" = t('policy_admin.confirm')
      button.btn.btn-secondary#policy-confirm-no type="button" = t('policy_admin.cancel')

  script#policy-translations type="application/json" == JSON.generate(t('policy_admin')).gsub('<', '\u003c')
script src="#{policy_path}/js/policy-json.js" defer=true
script src="#{policy_path}/js/policies.js?v=2" defer=true
