.users-admin-page.admin-page
  == slim :admin_navigation, layout: false
  - users_admin_config = { adminPath: admin_path, texts: { edit: t('user_admin.edit_user'), delete: t('user_admin.delete_user'), password: t('user_admin.change_password'), login: t('user_admin.fields.login'), email: t('user_admin.fields.email'), org: t('user_admin.fields.org'), role: t('user_admin.fields.role'), userFallback: 'user' } }
  .admin-content
    .users-admin-messages#users-admin-messages role="status" aria-live="polite"
    header.admin-heading
      div
        .admin-title
          h1 = t('user_admin.user_list')
          span.admin-count#users-count = users.length
        p.admin-subtitle#users-summary
      button.btn.btn-primary type="button" data-open-modal="create-user-modal"
        svg.admin-icon aria-hidden="true"
          use href="#admin-plus"
        = t('user_admin.create_user')
    section.admin-surface.admin-resource aria-label=t('user_admin.user_list')
      form.admin-filters#users-filters
        label.admin-search
          span = t('policy_admin.search')
          input type="search" name="search" placeholder=t('admin_ui.search_users')
        .admin-filter-fields#admin-filter-fields
          label
            span = t('user_admin.fields.org')
            select name="org"
              option value="" = t('admin_ui.all_orgs')
              - users.map { |user| user[:org].to_s }.reject(&:empty?).uniq.sort.each do |org|
                option value=org = org
          label
            span = t('user_admin.fields.role')
            select name="role"
              option value="" = t('admin_ui.all_roles')
              - users.map { |user| user[:role].to_s.empty? ? 'user' : user[:role] }.uniq.sort.each do |role|
                option value=role = role
        .admin-filter-actions
          button.btn.btn-secondary.admin-filter-toggle#admin-filter-toggle type="button" aria-expanded="false" aria-controls="admin-filter-fields" = t('admin_ui.filters')
          button.btn.btn-secondary type="submit" = t('policy_admin.filter')
      .admin-results
        span.admin-result-count#users-list-state role="status" aria-live="polite"
        .admin-filter-chips#admin-active-filters
        span#admin-filter-pending hidden=true = t('admin_ui.pending')
        button.btn.btn-quiet.admin-reset#admin-filter-reset type="button" hidden=true = t('admin_ui.reset')
      table.users-table.admin-table#users-table
        colgroup
          - [24, 30, 18, 10, 18].each do |width|
            col style="width:#{width}%"
        thead
          tr
            th scope="col" = t('user_admin.user_list')
            th scope="col" = t('user_admin.fields.email')
            th scope="col" = t('user_admin.fields.org')
            th scope="col" = t('user_admin.fields.role')
            th.admin-actions scope="col" = t('user_admin.actions')
        tbody#users-admin-table-body
      .admin-empty#users-empty hidden=true
        h2 = t('admin_ui.no_results')
    footer.admin-footer
      span Auth Slim
      span = "Build v " + (ENV['ORG_OPENCONTAINERS_IMAGE_VERSION'] || '0.0.0')

  dialog#create-user-modal data-modal="create-user-modal" aria-labelledby="create-user-title"
    .modal-card
      .modal-header
        h2#create-user-title = t('user_admin.create_user')
        button.btn.btn-close type="button" data-close-modal="create-user-modal" aria-label=t('user_admin.cancel') title=t('user_admin.cancel')
          svg.admin-icon aria-hidden="true"
            use href="#admin-close"
      .modal-body
        form.form-grid#users-admin-create-form method="post" action=admin_path
          .form-row.policy-full
            label for="modal-login" = "#{t('user_admin.fields.login')} *"
            input#modal-login type="text" name="login" required=true autocomplete="username" autofocus=true
          .form-row
            label for="modal-name" = t('user_admin.fields.name')
            input#modal-name type="text" name="name"
          .form-row
            label for="modal-email" = t('user_admin.fields.email')
            input#modal-email type="email" name="email"
          .form-row
            label for="modal-org" = t('user_admin.fields.org')
            input#modal-org type="text" name="org"
          .form-row
            label for="modal-role" = t('user_admin.fields.role')
            input#modal-role type="text" name="role"
          .form-row.policy-full
            label for="modal-password" = "#{t('user_admin.fields.password')} *"
            input#modal-password type="password" name="password" required=true autocomplete="new-password"
        p.policy-muted = t('admin_ui.role_hint')
      footer.modal-actions
        button.btn.btn-secondary type="button" data-close-modal="create-user-modal" = t('user_admin.cancel')
        button.btn.btn-primary type="submit" form="users-admin-create-form" = t('user_admin.create_user')

  dialog#edit-user-modal data-modal="edit-user-modal" aria-labelledby="edit-user-title"
    .modal-card
      .modal-header
        h2#edit-user-title = t('user_admin.edit_user')
        button.btn.btn-close type="button" data-close-modal="edit-user-modal" aria-label=t('user_admin.cancel') title=t('user_admin.cancel')
          svg.admin-icon aria-hidden="true"
            use href="#admin-close"
      .modal-body
        p.readonly-login
          span = "#{t('user_admin.fields.login')}: "
          strong#users-admin-edit-login
        form.form-grid#users-admin-edit-form method="post"
          .form-row
            label for="edit-name" = t('user_admin.fields.name')
            input#edit-name type="text" name="name" autofocus=true
          .form-row
            label for="edit-email" = t('user_admin.fields.email')
            input#edit-email type="email" name="email"
          .form-row
            label for="edit-org" = t('user_admin.fields.org')
            input#edit-org type="text" name="org"
          .form-row
            label for="edit-role" = t('user_admin.fields.role')
            input#edit-role type="text" name="role"
        p.policy-muted = t('admin_ui.role_hint')
        details.password-section#users-password-section
          summary = t('user_admin.change_password')
          form.password-form#users-admin-password-form method="post"
            .form-row
              label for="edit-password" = t('user_admin.fields.password')
              input#edit-password type="password" name="password" required=true autocomplete="new-password"
            button.btn.btn-secondary type="submit" = t('user_admin.change_password')
      footer.modal-actions
        button.btn.btn-secondary type="button" data-close-modal="edit-user-modal" = t('user_admin.cancel')
        button.btn.btn-primary type="submit" form="users-admin-edit-form" = t('user_admin.save')

  dialog#delete-user-modal data-modal="delete-user-modal" aria-labelledby="delete-user-title"
    .modal-card
      .modal-header
        h2#delete-user-title = t('user_admin.delete_user')
        button.btn.btn-close type="button" data-close-modal="delete-user-modal" aria-label=t('user_admin.cancel') title=t('user_admin.cancel')
          svg.admin-icon aria-hidden="true"
            use href="#admin-close"
      .modal-body
        p.readonly-login#users-admin-delete-login
        p = t('user_admin.delete_confirmation')
        form#users-admin-delete-form method="post"
      footer.modal-actions
        button.btn.btn-secondary type="button" data-close-modal="delete-user-modal" = t('user_admin.cancel')
        button.btn.btn-danger type="submit" form="users-admin-delete-form" = t('user_admin.delete_user')

  script id="users-admin-data" type="application/json" == JSON.generate(users).gsub('<', '\u003c')
  script id="users-admin-config" type="application/json" == JSON.generate(users_admin_config).gsub('<', '\u003c')
  script type="text/javascript"
    |
      (() => {
        const config = JSON.parse(document.getElementById('users-admin-config').textContent || '{}');
        const adminPath = config.adminPath || '';
        const messagesEl = document.getElementById('users-admin-messages');
        const tableBodyEl = document.getElementById('users-admin-table-body');
        const initialUsers = JSON.parse(document.getElementById('users-admin-data').textContent || '[]');
        const modals = document.querySelectorAll('[data-modal]');
        const createForm = document.getElementById('users-admin-create-form');
        const editForm = document.getElementById('users-admin-edit-form');
        const passwordForm = document.getElementById('users-admin-password-form');
        const deleteForm = document.getElementById('users-admin-delete-form');
        const editLoginTitleEl = document.getElementById('users-admin-edit-login');
        const deleteLoginTitleEl = document.getElementById('users-admin-delete-login');
        const texts = config.texts || {edit: 'Edit', delete: 'Delete', userFallback: 'user'};

        const state = {users: initialUsers, filters: {search: '', org: '', role: ''}};
        const ui = window.AdminUI;
        const text = (key, values = {}) => Object.entries(values).reduce((value, [name, content]) => value.replaceAll(`{${name}}`, content), ui.texts[key] || key);
        const filterForm = document.getElementById('users-filters');
        const modalTriggers = new WeakMap();

        function escapeHtml(value) {
          return String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#39;');
        }

        function roleText(user) {
          return user.role && user.role.length > 0 ? user.role : texts.userFallback;
        }

        function rowMarkup(user) {
          const login = escapeHtml(user.login);
          return `
            <tr>
              <td class="admin-identity-cell" data-label="${escapeHtml(texts.login)}">
                <button class="admin-identity" type="button" data-login="${login}">${login}</button>
                ${user.name && user.name !== user.login ? `<div class="user-meta">${escapeHtml(user.name)}</div>` : ''}
              </td>
              <td class="admin-email-cell" data-label="${escapeHtml(texts.email)}">${escapeHtml(user.email || text('not_specified'))}</td>
              <td data-label="${escapeHtml(texts.org)}">${escapeHtml(user.org || '—')}</td>
              <td data-label="${escapeHtml(texts.role)}"><span class="role-text">${escapeHtml(roleText(user))}</span></td>
              <td class="admin-actions">
                <div class="row-actions">
                  <button class="btn btn-quiet" type="button" data-login="${login}" aria-label="${escapeHtml(texts.edit)} ${login}">${escapeHtml(texts.edit)}</button>
                  <details class="admin-menu">
                    <summary aria-label="${escapeHtml(text('more'))} ${login}" title="${escapeHtml(text('more'))}">${ui.icon('more')}</summary>
                    <div class="admin-menu-items">
                      <button class="btn btn-quiet" type="button" data-password-login="${login}">${escapeHtml(texts.password)}</button>
                      <button class="btn btn-danger" type="button" data-delete-login="${login}">${escapeHtml(texts.delete)}</button>
                    </div>
                  </details>
                </div>
              </td>
            </tr>
          `;
        }

        function renderTable() {
          const filters = state.filters;
          const search = filters.search.trim().toLocaleLowerCase();
          const visible = state.users.filter(user => `${user.login} ${user.name || ''} ${user.email || ''}`.toLocaleLowerCase().includes(search)
            && (!filters.org || user.org === filters.org) && (!filters.role || roleText(user) === filters.role));
          tableBodyEl.innerHTML = visible.map(rowMarkup).join('');
          document.getElementById('users-table').hidden = !visible.length;
          document.getElementById('users-empty').hidden = !!visible.length;
          document.getElementById('users-count').textContent = state.users.length;
          document.getElementById('users-list-state').textContent = text('results', {count: visible.length, total: state.users.length});
          document.getElementById('users-summary').textContent = text('summary', {
            admins: state.users.filter(user => user.role === 'admin').length,
            organizations: new Set(state.users.map(user => user.org).filter(Boolean)).size
          });
          ['org', 'role'].forEach(key => {
            const select = filterForm.elements.namedItem(key);
            const selected = select.value;
            const options = [...new Set(state.users.map(user => key === 'role' ? roleText(user) : user.org).filter(Boolean))];
            if (selected && !options.includes(selected)) options.push(selected);
            select.innerHTML = `<option value="">${escapeHtml(text(key === 'org' ? 'all_orgs' : 'all_roles'))}</option>` + options.sort().map(value => `<option value="${escapeHtml(value)}">${escapeHtml(value)}</option>`).join('');
            select.value = selected;
          });
        }

        function setFlash(type, message) {
          if (!message) return;
          clearFlash();
          const activeDialog = document.querySelector('dialog[data-modal][open] .modal-body');
          if (type === 'error' && activeDialog) {
            const error = document.createElement('p');
            error.className = 'flash error'; error.setAttribute('role', 'alert'); error.textContent = message;
            activeDialog.prepend(error); activeDialog.scrollTop = 0;
          } else messagesEl.innerHTML = `<div class="flash ${escapeHtml(type)}">${escapeHtml(message)}</div>`;
        }

        function clearFlash() {
          messagesEl.innerHTML = '';
          document.querySelectorAll('dialog .flash').forEach(message => message.remove());
        }

        function openModal(name) {
          const modal = document.querySelector(`[data-modal="${name}"]`);
          if (!modal || modal.open) return;
          modalTriggers.set(modal, document.activeElement);
          modal.showModal();
          (modal.querySelector('[autofocus]') || modal.querySelector('input:not([disabled]), button'))?.focus();
          modal.querySelector('.modal-body').scrollTop = 0;
        }

        function resetModal(name) {
          if (name === 'create-user-modal') {
            createForm.reset();
          }

          if (name === 'edit-user-modal') {
            editForm.reset();
            passwordForm.reset();
            editLoginTitleEl.textContent = '';
            document.getElementById('users-password-section').open = false;
            editForm.action = '';
            passwordForm.action = '';
          }

          if (name === 'delete-user-modal') {
            deleteForm.reset();
            deleteLoginTitleEl.textContent = '';
            deleteForm.action = '';
          }
        }

        function closeModal(name) {
          const modal = document.querySelector(`[data-modal="${name}"]`);
          if (!modal) return;

          modal.close();
        }

        modals.forEach(modal => modal.addEventListener('close', () => {
          resetModal(modal.dataset.modal);
          const trigger = modalTriggers.get(modal);
          if (trigger?.isConnected) trigger.focus();
          else document.querySelector('[data-open-modal="create-user-modal"]').focus();
        }));

        function findUser(login) {
          return state.users.find((user) => user.login === login);
        }

        function openEditModal(login) {
          const user = findUser(login);
          if (!user) return;

          editLoginTitleEl.textContent = user.login;
          document.getElementById('edit-name').value = user.name || '';
          document.getElementById('edit-role').value = user.role || '';
          document.getElementById('edit-org').value = user.org || '';
          document.getElementById('edit-email').value = user.email || '';
          document.getElementById('edit-password').value = '';
          editForm.action = `${adminPath}/${encodeURIComponent(user.login)}`;
          passwordForm.action = `${adminPath}/${encodeURIComponent(user.login)}/password`;
          openModal('edit-user-modal');
        }

        function openDeleteModal(login) {
          const user = findUser(login);
          if (!user) return;

          deleteLoginTitleEl.textContent = user.login;
          deleteForm.action = `${adminPath}/${encodeURIComponent(user.login)}/delete`;
          openModal('delete-user-modal');
        }

        async function request(form) {
          const response = await fetch(form.action, {
            method: 'POST',
            headers: {
              'Accept': 'application/json',
              'X-Requested-With': 'XMLHttpRequest'
            },
            body: new FormData(form)
          });

          let payload = {};
          try {
            payload = await response.json();
          } catch (_error) {
            payload = {};
          }

          if (!response.ok) {
            throw new Error(payload.error || `Request failed: ${response.status}`);
          }

          return payload;
        }

        function submitButtonFor(form) {
          return form.querySelector('button[type="submit"]') || document.querySelector(`button[type="submit"][form="${form.id}"]`);
        }

        function withPending(button, action) {
          if (!button) {
            return Promise.resolve(action());
          }
          const originalDisabled = button.disabled;
          button.disabled = true;
          return Promise.resolve(action()).finally(() => {
            button.disabled = originalDisabled;
          });
        }

        createForm.addEventListener('submit', (event) => {
          event.preventDefault();
          const submitButton = submitButtonFor(createForm);
          withPending(submitButton, async () => {
            const payload = await request(createForm);
            state.users = payload.users || state.users;
            renderTable();
            closeModal('create-user-modal');
            setFlash('notice', payload.notice);
          }).catch((error) => setFlash('error', error.message));
        });

        editForm.addEventListener('submit', (event) => {
          event.preventDefault();
          const submitButton = submitButtonFor(editForm);
          withPending(submitButton, async () => {
            const payload = await request(editForm);
            state.users = payload.users || state.users;
            renderTable();
            closeModal('edit-user-modal');
            setFlash('notice', payload.notice);
          }).catch((error) => setFlash('error', error.message));
        });

        passwordForm.addEventListener('submit', (event) => {
          event.preventDefault();
          const submitButton = submitButtonFor(passwordForm);
          withPending(submitButton, async () => {
            const payload = await request(passwordForm);
            state.users = payload.users || state.users;
            document.getElementById('edit-password').value = '';
            closeModal('edit-user-modal');
            setFlash('notice', payload.notice);
          }).catch((error) => setFlash('error', error.message));
        });

        deleteForm.addEventListener('submit', (event) => {
          event.preventDefault();
          const submitButton = submitButtonFor(deleteForm);
          withPending(submitButton, async () => {
            const payload = await request(deleteForm);
            state.users = payload.users || state.users;
            renderTable();
            closeModal('delete-user-modal');
            setFlash('notice', payload.notice);
          }).catch((error) => setFlash('error', error.message));
        });

        document.addEventListener('click', (event) => {
          const openButton = event.target.closest('[data-open-modal]');
          if (openButton) {
            clearFlash();
            openModal(openButton.getAttribute('data-open-modal'));
            return;
          }

          const closeButton = event.target.closest('[data-close-modal]');
          if (closeButton) {
            closeModal(closeButton.getAttribute('data-close-modal'));
            return;
          }

          const passwordButton = event.target.closest('[data-password-login]');
          if (passwordButton) {
            clearFlash();
            openEditModal(passwordButton.getAttribute('data-password-login'));
            document.getElementById('users-password-section').open = true;
            document.getElementById('edit-password').focus();
            return;
          }

          const editButton = event.target.closest('[data-login]');
          if (editButton) {
            clearFlash();
            openEditModal(editButton.getAttribute('data-login'));
            return;
          }

          const deleteButton = event.target.closest('[data-delete-login]');
          if (deleteButton) {
            clearFlash();
            openDeleteModal(deleteButton.getAttribute('data-delete-login'));
            return;
          }

          const overlay = event.target.closest('dialog[data-modal]');
          if (overlay && event.target === overlay) {
            closeModal(overlay.getAttribute('data-modal'));
          }
        });

        ui.filters(filterForm, filters => { state.filters = filters; renderTable(); });
        renderTable();
      })();
